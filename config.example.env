# Configuration for Mr. Singh Pizza Automated Answering Machine
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=development
FLASK_APP=src/main.py
SECRET_KEY=your-secret-key-here-change-in-production

# Twilio Configuration (for phone integration)
# TWILIO_AUTH_TOKEN is REQUIRED in production: the app uses it to verify that
# incoming /voice requests are genuinely from Twilio. If it is unset, request
# signature validation is disabled (fine for local testing, unsafe in prod).
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Restaurant details shown on the website and spoken to callers
RESTAURANT_PHONE=+1 (234) 567-890
RESTAURANT_ADDRESS=123 Pizza Street, Food City, FC 12345

# Kitchen dashboard (/staff) HTTP Basic auth. If STAFF_PASSWORD is unset the
# dashboard is open (local testing only). Set both in production.
STAFF_USERNAME=kitchen
STAFF_PASSWORD=change-me

# Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=True

# Application Settings
BUSINESS_NAME="Mr. Singh Pizza"
BUSINESS_PHONE="+1234567890"
BUSINESS_ADDRESS="123 Pizza Street, Food City, FC 12345"
BUSINESS_EMAIL="info@mrssinghpizza.com"

# Business Hours (24-hour format)
MONDAY_OPEN=11:00
MONDAY_CLOSE=22:00
TUESDAY_OPEN=11:00
TUESDAY_CLOSE=22:00
WEDNESDAY_OPEN=11:00
WEDNESDAY_CLOSE=22:00
THURSDAY_OPEN=11:00
THURSDAY_CLOSE=22:00
FRIDAY_OPEN=11:00
FRIDAY_CLOSE=23:00
SATURDAY_OPEN=11:00
SATURDAY_CLOSE=23:00
SUNDAY_OPEN=12:00
SUNDAY_CLOSE=21:00

# Delivery Settings
DELIVERY_FREE_THRESHOLD=25.00
DELIVERY_FEE=3.00
DELIVERY_RADIUS_MILES=5

# Loyalty Program
POINTS_PER_DOLLAR=1
POINTS_FOR_FREE_ITEM=100

# Audio Settings
TTS_ENGINE=gtts  # Options: gtts, pyttsx3
VOICE_LANGUAGE=en
VOICE_SPEED=1.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pizza_bot.log